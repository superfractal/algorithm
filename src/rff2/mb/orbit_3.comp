            for (uint k = 0; k < 8; ++k)
                result[at + k] = cut + k < L ? result[st + comp * L + cut + k] : 0;
            result[at + 8] = cut;
            result[at + 9] = msd != 0 ? result[meta + 12 * seg + c] : 0u;
            return;
        }
    }
}
